# ──────────────────────────────────────────────────────────────────────
# COMUNITI-MANAGER · Variables de entorno OPCIONALES
# Sin estas variables el arnés funciona igual: las herramientas quedan
# en estado honesto `AWAITING_CREDENTIALS` (nada se simula).
# Copia este archivo a `.env` y rellena solo lo que uses.
# ──────────────────────────────────────────────────────────────────────

# Base de datos: la ruta vive en prisma/schema.prisma (SQLite, sin config).
# DATABASE_URL solo es necesaria si apuntas a otro fichero.

# ── Semilla ALBRA (AGENTE-GENERAL) ────────────────────────────────────
ALBRA_SEED_URL=
ALBRA_SEED_TOKEN=

# ── Ecosistema ALBRA8 (el arnés orquesta, no duplica) ─────────────────
CRM_ALBRA_URL=
CRM_ALBRA_API_KEY=
CHISMOSO_URL=
LEADS_WEBHOOK_SECRET=
WHATPOWER_URL=
KREA_URL=
KREA_API_KEY=
YTAUTO_URL=
NEXSCOPE_URL=

# ── Proveedores de publicación (primario: Postgale) ───────────────────
POSTGALE_URL=
POSTGALE_API_KEY=
POSTGALE_WEBHOOK_SECRET=
POSTIZ_URL=
POSTIZ_API_KEY=
POSTLAKE_URL=
POSTLAKE_API_KEY=

# ── Herramientas externas ─────────────────────────────────────────────
SCRAPECREATORS_API_KEY=

# ── Seguridad del arnés (webhooks salientes) ──────────────────────────
HARNESS_WEBHOOK_SECRET=
