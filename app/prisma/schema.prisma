// Social Autopilot AI — Arnés de community management
// Memoria persistente: sobrevive a reinicios, aislada por marca.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./db/harness.db"
}

// ─── Marcas y cuentas ─────────────────────────────────────────────

model Brand {
  id               String   @id @default(cuid())
  name             String   @unique
  identity         String   // identidad de marca
  products         String   @default("")
  audience         String   @default("")
  tone             String   @default("")
  vocabulary       String   @default("") // vocabulario preferido (separado por comas)
  forbiddenWords   String   @default("") // palabras prohibidas (separado por comas)
  policies         String   @default("") // políticas comerciales
  faqs             String   @default("[]") // JSON [{q,a}]
  approvedExamples String   @default("[]") // JSON [{network,text}]
  supportInfo      String   @default("")
  budgetDaily      Float    @default(0)
  maxPostsPerDay   Int      @default(3)
  allowedHours     String   @default("08-20")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  drafts      ContentDraft[]
  publications Publication[]
  comments    Comment[]
  tasks       Task[]
  evidences   Evidence[]
  metrics     MetricSnapshot[]
  experiments Experiment[]
  accounts    SocialAccount[]
  schedules   Schedule[]
  skills      Skill[]
}

model SocialAccount {
  id                String  @id @default(cuid())
  brandId           String
  network           String // instagram | facebook | tiktok | x | linkedin | youtube | threads | whatsapp
  handle            String
  status            String  @default("AWAITING_CREDENTIALS") // CONNECTED | AWAITING_CREDENTIALS | DISABLED
  providerAccountId String  @default("")
  brand             Brand   @relation(fields: [brandId], references: [id])

  @@unique([brandId, network, handle])
}

// ─── Contenido y publicaciones ────────────────────────────────────

model ContentDraft {
  id         String   @id @default(cuid())
  brandId    String
  objective  String
  brief      String   @default("") // brief creativo
  status     String   @default("DRAFT") // DRAFT | IN_REVIEW | APPROVED | SCHEDULED | PUBLISHED | REJECTED | FAILED
  version    Int      @default(1)
  theme      String   @default("") // pilar de contenido
  sourceTask String?  // taskId que lo originó
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  brand        Brand     @relation(fields: [brandId], references: [id])
  versions     PostVersion[]
  publications Publication[]
}

model PostVersion {
  id       String @id @default(cuid())
  draftId  String
  network  String
  text     String
  mediaJson String @default("[]") // [{type,url,alt,source}]
  specCheck String @default("{}") // validación de specs por red {ok, issues[]}
  draft    ContentDraft @relation(fields: [draftId], references: [id])

  @@unique([draftId, network, text])
}

model Publication {
  id             String    @id @default(cuid())
  brandId        String
  draftId        String
  network        String
  scheduledAt    DateTime?
  publishedAt    DateTime?
  status         String    @default("PENDING") // PENDING | SCHEDULED | PUBLISHING | PUBLISHED | FAILED | CANCELLED | AWAITING_CONNECTOR
  externalId     String?   // id en la red / proveedor
  verifyStatus   String    @default("UNVERIFIED") // UNVERIFIED | VERIFIED | NOT_FOUND
  idempotencyKey String    @unique
  errorDetail    String    @default("")
  evidenceId     String?
  createdAt      DateTime  @default(now())

  brand Brand        @relation(fields: [brandId], references: [id])
  draft ContentDraft @relation(fields: [draftId], references: [id])
}

// ─── Comunidad ────────────────────────────────────────────────────

model Comment {
  id             String   @id @default(cuid())
  brandId        String
  network        String
  externalId     String   @default("")
  author         String   @default("")
  text           String
  kind           String   @default("COMMENT") // COMMENT | MESSAGE
  classification String   @default("PENDING") // FAQ | PRODUCT_INQUIRY | SALES_REQUEST | LEAD | SUPPORT | COMPLAINT | REFUND | SPAM | FRAUD | ABUSE | CRISIS | HUMAN_REQUIRED | PENDING
  sentiment      String   @default("NEUTRAL") // POSITIVE | NEUTRAL | NEGATIVE
  risk           String   @default("LOW") // LOW | MEDIUM | HIGH | CRITICAL
  status         String   @default("PENDING") // PENDING | CLASSIFIED | REPLIED | ESCALATED | MODERATED | IGNORED
  suggestedReply String   @default("")
  replyText      String   @default("")
  repliedAt      DateTime?
  evidence       String   @default("")
  createdAt      DateTime @default(now())

  brand Brand @relation(fields: [brandId], references: [id])

  @@unique([brandId, network, externalId, kind])
}

// ─── Aprobaciones ─────────────────────────────────────────────────

model Approval {
  id         String    @id @default(cuid())
  brandId    String
  targetType String // PUBLICATION | REPLY | MODERATION | CAMPAIGN
  targetId   String
  summary    String
  risk       String    @default("MEDIUM") // LOW | MEDIUM | HIGH | CRITICAL
  status     String    @default("PENDING") // PENDING | APPROVED | REJECTED
  requestedBy String   @default("system")
  decidedBy  String?
  reason     String    @default("")
  decidedAt  DateTime?
  createdAt  DateTime  @default(now())
}

// ─── Orquestador y tareas ─────────────────────────────────────────

model Task {
  id             String    @id @default(cuid())
  brandId        String
  type           String // RESEARCH | ANALYZE | PLAN | CREATE | VALIDATE | PUBLISH | VERIFY | ENGAGE | MEASURE | LEARN | OPTIMIZE | REPLY | MODERATE
  agent          String // strategy | researcher | trends | planner | writer | creative | adapter | publisher | community | moderator | capture | analyst | optimizer | supervisor
  status         String    @default("PENDING") // PENDING | RUNNING | WAITING_APPROVAL | COMPLETED | FAILED | CANCELLED | PAUSED
  phase          String    @default("") // fase del ciclo autónomo
  inputJson      String    @default("{}")
  outputJson     String    @default("{}")
  attempts       Int       @default(0)
  maxAttempts    Int       @default(3)
  nextRetryAt    DateTime?
  idempotencyKey String?   @unique
  errorDetail    String    @default("")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  brand  Brand      @relation(fields: [brandId], references: [id])
  events TaskEvent[]
}

model TaskEvent {
  id        String   @id @default(cuid())
  taskId    String
  phase     String
  message   String
  dataJson  String   @default("{}")
  createdAt DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id])
}

// ─── Herramientas y llamadas ──────────────────────────────────────

model ToolRecord {
  id           String  @id @default(cuid())
  key          String  @unique // postgale.publish | scrapecreators.research | krea.generate...
  provider     String
  category     String // PUBLISH | RESEARCH | CREATIVITY | ECOSYSTEM | ANALYTICS
  description  String
  contracts    String  @default("[]") // contratos internos soportados JSON[]
  status       String  @default("AWAITING_CREDENTIALS") // CONNECTED | AWAITING_CREDENTIALS | UNAVAILABLE | DISABLED
  capabilities String  @default("[]")
  rateLimit    String  @default("")
  costNote     String  @default("")
  lastResult   String  @default("") // OK | ERROR | ""
  lastCheckedAt DateTime?
}

model ToolCall {
  id         String   @id @default(cuid())
  toolKey    String
  contract   String
  reqJson    String   @default("{}")
  resJson    String   @default("{}")
  outcome    String // OK | ERROR | CAPACITY_UNAVAILABLE
  durationMs Int      @default(0)
  createdAt  DateTime @default(now())
}

// ─── Evidencias, métricas, experimentos ───────────────────────────

model Evidence {
  id         String   @id @default(cuid())
  brandId    String
  source     String // scrapecreators | chismoso | web | manual
  url        String   @default("")
  claim      String // qué afirma esta evidencia
  payloadJson String  @default("{}")
  checksum   String   @default("")
  capturedAt DateTime @default(now())

  brand Brand @relation(fields: [brandId], references: [id])
}

model MetricSnapshot {
  id          String   @id @default(cuid())
  brandId     String
  network     String
  externalId  String   @default("")
  date        DateTime
  metricsJson String   @default("{}") // {impressions, engagement, clicks, followers...}
  verified    Boolean  @default(false) // true = datos del proveedor; false = estimación
  note        String   @default("")

  brand Brand @relation(fields: [brandId], references: [id])

  @@unique([brandId, network, externalId, date])
}

model Experiment {
  id           String   @id @default(cuid())
  brandId      String
  hypothesis   String
  variantA     String
  variantB     String
  resultJson   String   @default("{}")
  conclusion   String   @default("")
  status       String   @default("RUNNING") // RUNNING | CONCLUDED
  createdAt    DateTime @default(now())

  brand Brand @relation(fields: [brandId], references: [id])
}

// ─── Errores y auditoría ──────────────────────────────────────────

model ErrorLog {
  id         String   @id @default(cuid())
  brandId    String?
  source     String
  severity   String   @default("ERROR") // WARNING | ERROR | CRITICAL
  message    String
  detailJson String   @default("{}")
  recovery   String   @default("") // acción de recuperación sugerida
  resolved   Boolean  @default(false)
  createdAt  DateTime @default(now())
}

model AuditEntry {
  id         String   @id @default(cuid())
  actor      String // agent:<name> | human | system
  action     String
  targetType String
  targetId   String   @default("")
  allowed    Boolean  @default(true)
  reason     String   @default("")
  dataJson   String   @default("{}")
  createdAt  DateTime @default(now())
}

// ─── Programaciones (scheduler del ciclo) ─────────────────────────

model Schedule {
  id         String   @id @default(cuid())
  brandId    String
  name       String   @default("Ciclo diario")
  hour       Int // 0-23, hora local según timezone
  minute     Int      @default(0) // 0-59
  days       String   @default("1,2,3,4,5,6,7") // días de la semana ISO (1=lunes)
  timezone   String   @default("America/Bogota")
  topic      String   @default("") // tema opcional para el ciclo
  objective  String   @default("") // objetivo opcional para el ciclo
  enabled    Boolean  @default(true)
  lastRunAt  DateTime? // anti-duplicado: no re-disparar el mismo día
  lastResult String   @default("") // resumen honesto de la última ejecución
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  brand Brand @relation(fields: [brandId], references: [id])

  @@index([brandId, enabled])
}

// ─── Biblioteca de habilidades (SKILL.md versionadas) ─────────────

model Skill {
  id        String   @id @default(cuid())
  brandId   String? // null = skill global; si tiene marca, es específica
  key       String   @unique // slug estable, p.ej. "post-valor-3-actos"
  name      String
  category  String   @default("CONTENT") // CONTENT | ENGAGEMENT | ANALYTICS | CRISIS | GROWTH
  format    String   @default("SKILL.md")
  body      String // contenido markdown completo de la habilidad
  version   Int      @default(1) // se incrementa en cada edición
  status    String   @default("ACTIVE") // DRAFT | ACTIVE | ARCHIVED
  source    String   @default("manual") // manual | semilla
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  brand Brand? @relation(fields: [brandId], references: [id])
}

// ─── Configuración ────────────────────────────────────────────────

model Setting {
  key   String @id
  value String
}

// ─── Módulo FB-GROUPS (pantalón) — FICHA modulo-fb-groups/FICHA.md ──

model FbWorker {
  id             String    @id @default(cuid())
  name           String
  baseUrl        String    @unique // p.ej. http://192.168.1.10:8765
  mode           String    @default("pc") // pc | vps
  secret         String    // secreto HMAC por worker (se muestra una vez)
  status         String    @default("OFFLINE") // OFFLINE | IDLE | RUNNING | AWAITING_SESSION | PAUSED_ANTI_BAN | CHALLENGE_DETECTED
  lastSeenAt     DateTime?
  sessionAgeDays Int       @default(30) // antigüedad declarada de la cuenta FB (warmup)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  jobs FbJob[]
}

model FbGroup {
  id           String    @id @default(cuid())
  fbId         String    @unique // identificador normalizado del grupo
  name         String
  url          String    @default("")
  collection   String    @default("general")
  excluded     Boolean   @default(false) // fuera de rotación
  lastPostedAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  jobs FbJob[]
}

model FbCampaign {
  id           String   @id @default(cuid())
  brandId      String?
  draftId      String?  // origen opcional en el calendario
  name         String
  text         String   // texto base aprobado
  mode         String   @default("group") // group | profile | page_in_group
  engine       String   @default("dom") // dom | internal
  pageName     String   @default("") // si mode=page_in_group
  firstComment String   @default("")
  windowStart  Int      @default(7) // hora local inicio ventana de publicación
  windowEnd    Int      @default(21)
  mediaUrls    String   @default("[]") // JSON: hasta 4 adjuntos (URL http(s) o ruta local del worker)
  status       String   @default("QUEUED") // QUEUED | RUNNING | DONE | PAUSED | CANCELLED
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  jobs FbJob[]
}

model FbJob {
  id            String    @id @default(cuid())
  campaignId    String
  groupId       String?
  workerId      String?
  targetKind    String    @default("group") // group | profile | page_in_group
  targetName    String    // nombre del grupo o "PERFIL"
  targetUrl     String    @default("")
  variant       String    @default("") // texto final tras spintax/IA
  variantSource String    @default("base") // base | spintax | ai_rewrite
  mediaUrls     String    @default("[]") // copia de los adjuntos de la campaña al crear el job
  status        String    @default("QUEUED") // QUEUED | LEASED | POSTED | FAILED | SKIPPED | PENDING_REVIEW | CANCELLED
  leaseUntil    DateTime?
  attempts      Int       @default(0)
  postUrl       String    @default("")
  failReason    String    @default("")
  postedAt      DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  campaign FbCampaign @relation(fields: [campaignId], references: [id])
  group    FbGroup?   @relation(fields: [groupId], references: [id])
  worker   FbWorker?  @relation(fields: [workerId], references: [id])

  @@index([status, leaseUntil])
}

model FbDailyUsage {
  id       String @id @default(cuid())
  workerId String
  day      String // YYYY-MM-DD en zona horaria de la cuenta
  posts    Int    @default(0)
  cap      Int    @default(5)

  @@unique([workerId, day])
}

model FbAlert {
  id          String    @id @default(cuid())
  workerId    String?
  kind        String    // CHALLENGE | WARNING | BLOCKED_GROUP | INFO
  message     String
  pausedUntil DateTime?
  resolved    Boolean   @default(false)
  createdAt   DateTime  @default(now())
}
