# Worker FB-GROUPS — copia a .env y completa
FB_WORKER_PORT=8765
HARNESS_URL=http://localhost:3000
WORKER_ID=
WORKER_SECRET=
FB_PROFILE_DIR=./chrome-profile
FB_HEADFUL=1
FB_NIGHT_START=22
FB_NIGHT_END=7
FB_MIN_GAP_MIN=3
FB_MAX_GAP_MIN=10
FB_TICK_SECONDS=60
FB_JOIN_GAP_MIN=20
FB_JOIN_GAP_MAX=45
# Proxy opcional por worker (el Chrome completo sale por aquí; sin él, salida directa)
# FB_PROXY=http://usuario:pass@proxy.local:8080
# FB_PROXY=socks5://host:1080
# FB_PROXY_USERNAME=
# FB_PROXY_PASSWORD=
