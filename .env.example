# COMUNITI-MANAGER — variables de entorno del panel (app/)
# Copiar este archivo a app/.env y completar solo lo que se use.
# Sin credenciales, los contratos quedan en AWAITING_CREDENTIALS con la
# variable exacta que falta (nada se simula). NUNCA commitear el .env real.
#
# Nota DB: la ruta de SQLite está fija en app/prisma/schema.prisma
# (prisma/db/harness.db); DATABASE_URL no se usa en runtime.

# ─── Seguridad del panel ──────────────────────────────────────────
# Token opcional para mutaciones del panel (cabecera x-panel-token,
# comparación en tiempo constante). Recomendado tras proxy público.
PANEL_TOKEN=
# Secreto HMAC de la malla: webhooks entrantes, tick externo y reportes del
# conector WhatsApp lo exigen (fail-closed sin él; solo loopback queda abierto).
HARNESS_WEBHOOK_SECRET=

# ─── Canales propios del agente ───────────────────────────────────
# Telegram: token de bot (se genera con @BotFather). Prueba real: getMe.
TELEGRAM_BOT_TOKEN=
# Override opcional de la API de Telegram (solo para tests con servidor mock;
# en producción NO definir — usa https://api.telegram.org).
# TELEGRAM_API_BASE=
# WhatsApp: conector propio (scripts/whatsapp-daemon.cjs). URL de su HTTP
# local (default http://127.0.0.1:3010) y token compartido del conector.
WHATSAPP_DAEMON_URL=
WHATSAPP_DAEMON_TOKEN=

# ─── Vías API multirred (Instagram/Facebook y demás redes) ────────
POSTGALE_URL=
POSTGALE_API_KEY=
POSTIZ_URL=
POSTIZ_API_KEY=
POSTLAKE_URL=
POSTLAKE_API_KEY=

# ─── Investigación (evidencia pública con URL/fecha/payload) ──────
SCRAPECREATORS_API_KEY=

# ─── Ecosistema OPCIONAL (mundo aparte: otros agentes) ────────────
# Nada de esto hace falta para publicar; se consume solo si el operador
# lo activa, vía malla firmada.
CHISMOSO_URL=
CRM_ALBRA_URL=
CRM_ALBRA_API_KEY=
WHATPOWER_URL=
KREA_URL=
KREA_API_KEY=
YTAUTO_URL=
NEXSCOPE_URL=
ALBRA_SEED_URL=
ALBRA_SEED_TOKEN=

# ─── Lado del conector WhatsApp (variables del DAEMON, no del panel) ──
# Documentadas para referencia; viven en el entorno donde corre
# scripts/whatsapp-daemon.cjs (ver DEPLOY.md):
#   HARNESS_URL (default http://localhost:3000)
#   HARNESS_WEBHOOK_SECRET (mismo secreto del panel)
#   WHATSAPP_DAEMON_NAME (default wa-local)
#   WHATSAPP_DAEMON_PORT (default 3010)
#   WHATSAPP_DAILY_CAP (default 200) · WHATSAPP_MIN_GAP_SECONDS (default 6)
